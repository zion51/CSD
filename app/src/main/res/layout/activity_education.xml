<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".EducationActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:title="Education Portal"
            app:titleCentered="true" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Exam Results Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Exam Results"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/primary"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:padding="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSSC"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="SSC Result"
                        app:icon="@android:drawable/ic_menu_agenda" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHSC"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="HSC Result"
                        app:icon="@android:drawable/ic_menu_agenda" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNU"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="NU Result"
                        app:icon="@android:drawable/ic_menu_info_details" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHonours"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="Honours Result"
                        app:icon="@android:drawable/ic_menu_info_details" />
                </GridLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Events Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Educational Events"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/primary"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:padding="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSeminar"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="start|center_vertical"
                        android:text="Seminar"
                        app:icon="@android:drawable/ic_menu_myplaces" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWorkshop"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="start|center_vertical"
                        android:text="Workshop"
                        app:icon="@android:drawable/ic_menu_manage" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTraining"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="start|center_vertical"
                        android:text="Training"
                        app:icon="@android:drawable/ic_menu_edit" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCompetition"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="start|center_vertical"
                        android:text="Competition"
                        app:icon="@android:drawable/ic_menu_gallery" />
                </GridLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Skill Development Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Skill Development courses"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/primary"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:padding="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWebDev"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="start|center_vertical"
                        android:text="Web Development"
                        app:icon="@android:drawable/ic_menu_agenda" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAndroidDev"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="start|center_vertical"
                        android:text="Android Development"
                        app:icon="@android:drawable/ic_menu_camera" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGraphicDesign"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="start|center_vertical"
                        android:text="Graphic Design"
                        app:icon="@android:drawable/ic_menu_gallery" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVideoEditing"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="start|center_vertical"
                        android:text="Video Editing"
                        app:icon="@android:drawable/ic_menu_slideshow" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMsOffice"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="start|center_vertical"
                        android:text="Microsoft Office"
                        app:icon="@android:drawable/ic_menu_edit" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCvWriting"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="start|center_vertical"
                        android:text="CV Writing"
                        app:icon="@android:drawable/ic_menu_save" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnInterviewPrep"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="start|center_vertical"
                        android:text="Interview Prep"
                        app:icon="@android:drawable/ic_menu_call" />
                </GridLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tuition Section (Now below Skills) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tutors"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/primary"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTutors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                tools:listitem="@layout/item_tutor_display"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
